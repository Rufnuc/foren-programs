{
  "name": "forenlabs-prutet",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first, blockchain-anchored evidence vault.",
  "workspaces": [
    "circuits",
    "relay",
    "app"
  ],
  "scripts": {
    "lint": "prettier --check 'tests/**/*.ts' 'migrations/**/*.ts' 'circuits/scripts/**/*.ts'",
    "format": "prettier --write 'tests/**/*.ts' 'migrations/**/*.ts' 'circuits/scripts/**/*.ts'",
    "test:anchor": "anchor test",
    "test:anchor:skip-validator": "anchor test --skip-local-validator",
    "build:circuits": "yarn workspace @prutet/circuits build"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@solana/web3.js": "^1.95.0",
    "@types/bn.js": "^5.1.5",
    "@types/chai": "^4.3.16",
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.0",
    "chai": "^4.4.1",
    "mocha": "^10.4.0",
    "prettier": "^3.3.0",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20"
  }
}
