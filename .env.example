# Network selection for the frontend / scripts
SOLANA_CLUSTER=localnet           # localnet | devnet | mainnet-beta
SOLANA_RPC_URL=http://127.0.0.1:8899

# Relay (Phase 3) — populated later
RELAY_PORT=4000
IPFS_API_URL=http://127.0.0.1:5001
PINNING_PROVIDER=local            # local | web3storage | pinata

# Emergency dispatch (Phase 3) — leave blank in dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMTP_URL=

# Frontend (Phase 4)
NEXT_PUBLIC_RELAY_URL=http://127.0.0.1:4000
NEXT_PUBLIC_DEFAULT_LOCALE=en
